# CSP Lab Manager
# Copy to .env and fill the blank values before starting Compose.
# BETTER_AUTH_SECRET is 32+ characters. SEED_ADMIN_PASSWORD is 8+ characters.
# Published image: docker compose up -d
# Build from this repo: docker compose -f compose-dev.yaml up -d
# The container rewrites DATABASE_URL localhost to postgres and REDIS_URL localhost to valkey.

DATABASE_URL=postgresql://csplab:csplab_password@postgres:5432/csplab_db
REDIS_URL=redis://:valkey_password@valkey:6379
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=
APP_PORT=3000

# Postgres (official image + Compose port publish)
POSTGRES_USER=csplab
POSTGRES_PASSWORD=csplab_password
POSTGRES_DB=csplab_db
POSTGRES_PORT=5432

# Valkey (Compose requirepass + port publish)
VALKEY_PASSWORD=valkey_password
